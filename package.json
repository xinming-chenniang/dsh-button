{
  "name": "dsh-button",
  "version": "1.1.0",
  "private": true,
  "description": "One-click composer actions: send 「继续」, send your own configurable buttons (any text, e.g. to invoke a skill), resend your last message, and hide/restore either preset button. Text-only: no host commands.",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0-rc"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "closeout",
    "session",
    "ui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xinming-chenniang/dsh-button.git"
  },
  "homepage": "https://github.com/xinming-chenniang/dsh-button#readme",
  "bugs": {
    "url": "https://github.com/xinming-chenniang/dsh-button/issues"
  }
}





