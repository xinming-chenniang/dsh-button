{
  "name": "dsh-button",
  "version": "1.2.2",
  "private": false,
  "description": "One-click composer actions for DeepSeek Harness: a 「继续」 button (label and text editable), your own configurable text buttons (e.g. to invoke a skill), a 「重发上一条」 button (label editable, content is your last real message), plus hide/restore and five sensible default actions. Text-only: no host commands.",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/client.test.mjs test/buttons.test.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0-rc"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "assets"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "composer",
    "buttons",
    "quick-actions",
    "prompt",
    "ui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xinming-chenniang/dsh-button.git"
  },
  "homepage": "https://github.com/xinming-chenniang/dsh-button#readme",
  "bugs": {
    "url": "https://github.com/xinming-chenniang/dsh-button/issues"
  }
}





