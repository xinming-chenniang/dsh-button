{
  "name": "dsh-button",
  "version": "1.3.0",
  "private": false,
  "description": "Preset quick-input buttons for the DeepSeek Harness composer: save the repetitive prompts and phrases you retype, then send or insert them with one click. Reorder, move, resize; text only, no host commands, and an existing draft is never overwritten.",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/client.test.mjs test/buttons.test.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0-rc"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "assets"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "composer",
    "prompt-presets",
    "quick-input",
    "saved-phrases",
    "text-snippets",
    "quick-actions",
    "buttons",
    "productivity",
    "ui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xinming-chenniang/dsh-button.git"
  },
  "homepage": "https://github.com/xinming-chenniang/dsh-button#readme",
  "bugs": {
    "url": "https://github.com/xinming-chenniang/dsh-button/issues"
  }
}





